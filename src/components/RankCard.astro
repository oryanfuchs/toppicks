---
import type { RankedPick } from "../data/ranked";

type Props = {
  pick: RankedPick;
  visitUrl: string;
  markSrc: string;
};

const { pick, visitUrl, markSrc } = Astro.props;
---

<article
  class:list={["rank-card", { top: pick.rank === 1 }]}
  id={pick.slug}
  data-cats={pick.categories.join(" ")}
>
  <div class="card-accent" style={`background: ${pick.accent}`}></div>
  <div class="card-body">
    <div class="card-main">
      <div class="card-head">
        <div class="rank-num">{pick.rank}</div>
        <img class="host-mark" src={markSrc} alt="" width="48" height="48" />
        <div>
          <div class="badge">{pick.badge}</div>
          <h2 class="host-name">{pick.name}</h2>
        </div>
      </div>
      <p class="tagline">{pick.tagline}</p>
      <p class="summary">{pick.summary}</p>
      <dl class="spec-grid">
        {pick.specs.map((spec) => (
          <div>
            <dt>{spec.label}</dt>
            <dd>{spec.value}</dd>
          </div>
        ))}
      </dl>
      <div class="proscons">
        <div>
          <h3>Why it ranks</h3>
          <ul>
            {pick.pros.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <h3>Watch out</h3>
          <ul>
            {pick.cons.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      <div class="verdict">
        <p><strong>Buy if</strong> {pick.buyIf}</p>
        <p><strong>Skip if</strong> {pick.skipIf}</p>
      </div>
    </div>
    <aside class="cta-col">
      <div class="score-block">
        <div class="score"><strong>{pick.score.toFixed(1)}</strong>/10</div>
        <div class="meters">
          {pick.ratings.map((rating) => (
            <div class="meter">
              <span>{rating.label}</span>
              <div class="meter-bar" aria-label={`${rating.label} ${rating.value} of 5`}>
                <i style={`width: ${rating.value * 20}%`}></i>
              </div>
            </div>
          ))}
        </div>
      </div>
      <p class="price-block">
        <span class="price">From {pick.fromPrice}/mo</span>
        <span class="muted">{pick.priceNote}</span>
      </p>
      <a class="btn btn-primary" data-affiliate={pick.slug} href={visitUrl} rel="nofollow sponsored noopener" target="_blank">
        Visit {pick.name}
      </a>
      <a class="btn btn-ghost" href={`/reviews/${pick.slug}`}>{pick.name} review</a>
    </aside>
  </div>
</article>
