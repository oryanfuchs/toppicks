---
import { catalogBySlug } from "../data/catalog";

export type GuidePick = {
  slug: string;
  ifYou: string;
  note: string;
};

type Props = { picks: GuidePick[] };
const { picks } = Astro.props;
---

{
  picks.length > 0 && (
    <div class="guide-picks">
      {picks.map((pick) => {
        const item = catalogBySlug(pick.slug);
        if (!item) return null;
        return (
          <aside>
            <div class="guide-pick-head">
              <img class="host-mark" src={item.markSrc} alt="" width="40" height="40" />
              <div>
                <div class="label">{pick.ifYou}</div>
                <h3>{item.pick.name}</h3>
              </div>
            </div>
            <p>{pick.note}</p>
            <a
              class="btn btn-primary"
              data-affiliate={item.pick.slug}
              href={item.visitUrl}
              rel="nofollow sponsored noopener"
              target="_blank"
            >
              Visit {item.pick.name}
            </a>
            <a class="btn btn-ghost" href={`/reviews/${item.pick.slug}`}>
              {item.pick.name} review
            </a>
          </aside>
        );
      })}
    </div>
  )
}
