---
import Base from "../../layouts/Base.astro";
import { allReviewSlugs, catalogBySlug } from "../../data/catalog";
import { guides } from "../../data/guides";

export function getStaticPaths() {
  return allReviewSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const item = catalogBySlug(slug!);
if (!item) {
  throw new Error(`Missing pick ${slug}`);
}

const { pick, visitUrl, markSrc, rankingHref, rankingLabel, others, kind } = item;
const productLabel = kind === "email" ? "email marketing" : "web hosting";
const title = `${pick.name} Review 2026: Pricing, Pros, Cons & Who It’s For | Top Picks`;
const description = `${pick.name} ranked #${pick.rank} in our 2026 ${productLabel} ranking (${pick.score.toFixed(1)}/10). From ${pick.fromPrice}/mo. Best for ${pick.bestFor}. ${pick.summary}`;
const relatedGuides = guides
  .filter((guide) =>
    `${guide.title} ${guide.description} ${guide.paragraphs.join(" ")}`.toLowerCase().includes(pick.name.toLowerCase())
  )
  .slice(0, 3);

const reviewUrl = new URL(`/reviews/${pick.slug}`, Astro.site).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: rankingLabel, item: new URL(rankingHref, Astro.site).toString() },
        { "@type": "ListItem", position: 2, name: `${pick.name} review`, item: reviewUrl },
      ],
    },
    {
      "@type": "Review",
      name: `${pick.name} review 2026`,
      url: reviewUrl,
      dateModified: "2026-10-15",
      author: { "@type": "Organization", name: "Top Picks", url: "https://gettoppicks.com/" },
      itemReviewed: {
        "@type": "SoftwareApplication",
        name: `${pick.name} ${productLabel}`,
        description: pick.summary,
        brand: { "@type": "Brand", name: pick.name },
        offers: {
          "@type": "Offer",
          price: pick.fromPrice.replace(/[^0-9.]/g, ""),
          priceCurrency: pick.fromPrice.includes("€") ? "EUR" : "USD",
          url: reviewUrl,
        },
      },
      reviewRating: {
        "@type": "Rating",
        ratingValue: pick.score,
        bestRating: 10,
        worstRating: 1,
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: pick.faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
  ],
};
---

<Base title={title} description={description} path={`/reviews/${pick.slug}`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main class="wrap prose review-hero">
    <article>
      <p class="crumbs">
        <a href={rankingHref}>{rankingLabel}</a>
        <span aria-hidden="true"> / </span>
        <span>{pick.name} review</span>
      </p>
      <div class="review-head">
        <img class="host-mark" src={markSrc} alt="" width="56" height="56" />
        <div>
          <div class="kicker">Rank {pick.rank} · Score {pick.score.toFixed(1)}/10 · Updated October 2026</div>
          <h1>{pick.name} review 2026</h1>
        </div>
      </div>
      <p class="lede">{pick.summary}</p>
      <p>
        <span class="price">From {pick.fromPrice}/mo</span>
        <span class="muted"> · {pick.priceNote}</span>
      </p>
      <p><strong>Best for:</strong> {pick.bestFor}</p>
      <dl class="spec-grid">
        {pick.specs.map((spec) => (
          <div>
            <dt>{spec.label}</dt>
            <dd>{spec.value}</dd>
          </div>
        ))}
      </dl>
      <div class="verdict">
        <p><strong>Buy if</strong> {pick.buyIf}</p>
        <p><strong>Skip if</strong> {pick.skipIf}</p>
      </div>
      {pick.body.map((p) => <p>{p}</p>)}
      <h2>Pros</h2>
      <ul>
        {pick.pros.map((item) => <li>{item}</li>)}
      </ul>
      <h2>Cons</h2>
      <ul>
        {pick.cons.map((item) => <li>{item}</li>)}
      </ul>
      <h2>{pick.name} FAQ</h2>
      <div class="faq">
        {
          pick.faqs.map((faq) => (
            <details>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))
        }
      </div>
      <h2>Compare with other {kind === "email" ? "email tools" : "hosts"}</h2>
      <ul class="related">
        {others.map((other) => (
          <li>
            <a href={`/reviews/${other.slug}`}>{other.name} review 2026</a>
            <span class="muted"> — {other.badge}, from {other.fromPrice}/mo</span>
          </li>
        ))}
      </ul>
      {relatedGuides.length > 0 && (
        <>
          <h2>Related guides</h2>
          <ul class="related">
            {relatedGuides.map((guide) => (
              <li>
                <a href={`/guides/${guide.slug}`}>{guide.title}</a>
              </li>
            ))}
          </ul>
        </>
      )}
      <p><a href={rankingHref}>Back to the 2026 {productLabel} ranking</a></p>
    </article>
    <aside class="review-cta">
      <div class="label badge">{pick.badge}</div>
      <h2>{pick.name}</h2>
      <div class="score"><strong>{pick.score.toFixed(1)}</strong>/10</div>
      <div class="meters">
        {pick.ratings.map((rating) => (
          <div class="meter">
            <span>{rating.label}</span>
            <div class="meter-bar" aria-label={`${rating.label} ${rating.value} of 5`}>
              <i style={`width: ${rating.value * 20}%`}></i>
            </div>
          </div>
        ))}
      </div>
      <p>
        Advertised from {pick.fromPrice}/mo. Confirm the term length and renewal
        on the provider site before you pay.
      </p>
      <a class="btn btn-primary" data-affiliate={pick.slug} href={visitUrl} rel="nofollow sponsored noopener" target="_blank">
        Go to {pick.name}
      </a>
    </aside>
  </main>
</Base>
