---
import Base from "../layouts/Base.astro";
import { hosts } from "../data/hosts";
import { emailTools } from "../data/email";

const title = "Top Picks: independent rankings for 2026";
const description =
  "Editorial rankings of web hosting and email marketing. Five products each, scored for the job — not a 40-logo roundup.";

const verticals = [
  {
    href: "/hosting",
    kicker: "Web hosting",
    title: "Best web hosting 2026",
    lede: "Cheap WordPress, European VPS, and managed cloud. Specs, renewals, and who should skip each row.",
    winner: hosts[0],
    markSrc: `/hosts/${hosts[0].slug}-mark.svg`,
    items: hosts,
  },
  {
    href: "/email",
    kicker: "Email marketing",
    title: "Best email marketing 2026",
    lede: "A list after the site: creator tools, cheap volume, newsletters, and automation. Price honesty at 10,000 subscribers.",
    winner: emailTools[0],
    markSrc: `/email/${emailTools[0].slug}-mark.svg`,
    items: emailTools,
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      name: "Top Picks rankings 2026",
      description: "Editorial comparison rankings on gettoppicks.com.",
      url: "https://gettoppicks.com/",
      numberOfItems: verticals.length,
      itemListElement: verticals.map((vertical, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: vertical.title,
        url: new URL(vertical.href, Astro.site).toString(),
      })),
    },
  ],
};
---

<Base title={title} description={description} path="/">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main>
    <section class="hero">
      <div class="wrap home-hero">
        <div class="kicker">Editorial rankings · October 2026</div>
        <h1>Two jobs. Five picks each.</h1>
        <p class="lede">
          Independent rankings for people who want a clear buy, not a 40-page roundup.
          Web hosting if you need a site live. Email if you already have one and need a list.
        </p>
        <div class="hero-meta">
          <span>Last updated October 2026</span>
          <span>2 verticals</span>
          <a href="/methodology">How the scores work</a>
        </div>
      </div>
    </section>

    <section class="section" id="rankings">
      <div class="wrap">
        <div class="section-head">
          <h2>Choose a ranking</h2>
          <p>
            Each list is five products, a written argument, and a skip-if line.
            Order is editorial. Some buttons are affiliate links.
          </p>
        </div>
        <div class="vertical-grid">
          {
            verticals.map((vertical) => (
              <article class="vertical-card">
                <div class="kicker">{vertical.kicker}</div>
                <h2>
                  <a href={vertical.href}>{vertical.title}</a>
                </h2>
                <p>{vertical.lede}</p>
                <div class="vertical-winner">
                  <img class="host-mark" src={vertical.markSrc} alt="" width="40" height="40" />
                  <div>
                    <div class="label">#1 {vertical.winner.badge}</div>
                    <strong>{vertical.winner.name}</strong>
                    <span class="muted">
                      {vertical.winner.score.toFixed(1)}/10 · from {vertical.winner.fromPrice}/mo
                    </span>
                  </div>
                </div>
                <ol class="vertical-list">
                  {vertical.items.map((item) => (
                    <li>
                      <a href={`/reviews/${item.slug}`}>
                        <span>
                          #{item.rank} {item.name}
                        </span>
                        <span class="muted">{item.score.toFixed(1)}</span>
                      </a>
                    </li>
                  ))}
                </ol>
                <a class="btn btn-primary" href={vertical.href}>
                  Open {vertical.kicker.toLowerCase()} ranking
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Base>
